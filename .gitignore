# Extensions to ignore
*.json
*.csv
*.env

# Sensitive stuff (explicitly ignored)
secrets.env
targets.csv

# Don't ignore config.env
!config.env

# Don't ignore examples
!secrets.env.example
!targets.csv.example
!capture_queue.json.example
!manifest.json.example

# Folders to ignore
archive/
logs/
snapshots/
summaries/

# Other stuff to ignore
venv/
__pychache__/