# --- EMAIL DELAY -------------------------------------------------------------
# How many seconds to wait between sending each email (avoids Graph throttling)
SEND_DELAY=5

# How many times to retry a throttled Graph request before giving up
GRAPH_MAX_RETRIES=6

# --- CAPTURE (capture.py) ----------------------------------------------------
# Number of parallel threads for snapshot capture
CAPTURE_MAX_WORKERS=20

# Timeout per RTSP capture attempt in seconds
CAPTURE_TIMEOUT_S=15

# Number of capture retries per channel before writing a placeholder
CAPTURE_RETRIES=2

# --- COMPRESSION (compress.py) -----------------------------------------------
# Hard maximum for the entire snapshots folder in MB
COMPRESS_MAX_TOTAL_MB=34.0

# Standard per-image size target in KB (Pass 1)
COMPRESS_DEFAULT_MAX_KB=400

# --- PDF GENERATION (pdf.py) -------------------------------------------------
# Maximum number of camera images per PDF file (controls chunking / file size)
PDF_MAX_IMAGES_PER_PDF=64

# --- FILE / DIRECTORY PATHS --------------------------------------------------
SNAPSHOTS_DIR=snapshots
CAPTURE_QUEUE_FILE=capture_queue.json
MANIFEST_FILE=manifest.json
